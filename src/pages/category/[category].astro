---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { siteConfig, categoryById, absoluteUrl } from "../../../site.config";
import { allPublished, cardExcerpt, postPath } from "../../lib/posts";
import { formatDot } from "../../lib/dates";

export async function getStaticPaths() {
  const posts = await allPublished();
  return siteConfig.categories.map((category) => ({
    params: { category: category.id },
    props: { posts: posts.filter((post) => post.data.category === category.id) },
  }));
}
const { category } = Astro.params;
const { posts } = Astro.props;
const meta = categoryById(category ?? "");
const pageSize = siteConfig.postsPerPage;
const visible = posts.slice(0, pageSize);
const pages = Math.ceil(posts.length / pageSize);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: meta?.name,
  description: meta?.description,
  url: absoluteUrl(`/category/${category}/`),
};
---
<Base title={meta?.name ?? "분류"} description={meta?.description ?? siteConfig.description} path={`/category/${category}/`} current={category} jsonLd={[jsonLd]}>
  <main id="content" class="wrap page" data-pagefind-body>
    <header class="page-head">
      <div class="icon-title">
        <img src={`/icons/${category}.svg`} alt="" width="56" height="56" />
        <div>
          <p class="kicker">분류</p>
          <h1>{meta?.name}</h1>
        </div>
      </div>
      <p>{meta?.description}</p>
    </header>
    {meta && (
      <div class="chip-row">
        {meta.topics.map((topic) => (
          <a href={`/search/?q=${encodeURIComponent(topic.q)}`}>{topic.label}</a>
        ))}
      </div>
    )}
    {visible.length === 0 ? (
      <p class="empty-board">이 분류의 발행 글이 아직 없습니다.</p>
    ) : (
      <div class="cards">
        {visible.map((post, index) => (
          <Card
            href={postPath(post.id)}
            title={post.data.title}
            excerpt={cardExcerpt(post.data.description)}
            category={post.data.category}
            image={`/thumb/posts/${post.id}/card.png`}
            overlayTitle={post.data.thumbTitle || post.data.title}
            overlaySub={post.data.thumbSubtitle || post.data.main_query}
            date={formatDot(post.data.date)}
            eager={index === 0}
          />
        ))}
      </div>
    )}
    {pages > 1 && (
      <nav class="pager" aria-label="페이지">
        <span aria-current="page">1</span>
        {Array.from({ length: pages - 1 }, (_, index) => (
          <a href={`/category/${category}/${index + 2}/`}>{index + 2}</a>
        ))}
      </nav>
    )}
  </main>
</Base>

---
import Base from "../../../layouts/Base.astro";
import Card from "../../../components/Card.astro";
import { siteConfig, categoryById } from "../../../../site.config";
import { allPublished, cardExcerpt, postPath } from "../../../lib/posts";
import { formatDot } from "../../../lib/dates";

export async function getStaticPaths() {
  const posts = await allPublished();
  const paths: { params: { category: string; page: string }; props: { posts: typeof posts } }[] = [];
  for (const category of siteConfig.categories) {
    const matched = posts.filter((post) => post.data.category === category.id);
    const pages = Math.ceil(matched.length / siteConfig.postsPerPage);
    for (let page = 2; page <= pages; page += 1) {
      paths.push({ params: { category: category.id, page: String(page) }, props: { posts: matched } });
    }
  }
  return paths;
}
const { category, page } = Astro.params;
const { posts } = Astro.props;
const meta = categoryById(category ?? "");
const current = Number(page);
const start = (current - 1) * siteConfig.postsPerPage;
const visible = posts.slice(start, start + siteConfig.postsPerPage);
const pages = Math.ceil(posts.length / siteConfig.postsPerPage);
---
<Base title={`${meta?.name ?? "분류"} ${current}`} description={meta?.description ?? siteConfig.description} path={`/category/${category}/${current}/`} current={category}>
  <main id="content" class="wrap page" data-pagefind-body>
    <header class="page-head">
      <h1>{meta?.name}</h1>
      <p>{current}페이지</p>
    </header>
    <div class="cards">
      {visible.map((post) => (
        <Card
          href={postPath(post.id)}
          title={post.data.title}
          excerpt={cardExcerpt(post.data.description)}
          category={post.data.category}
          image={`/thumb/posts/${post.id}/card.png`}
          overlayTitle={post.data.thumbTitle || post.data.title}
          overlaySub={post.data.thumbSubtitle || post.data.main_query}
          date={formatDot(post.data.date)}
        />
      ))}
    </div>
    <nav class="pager" aria-label="페이지">
      <a href={`/category/${category}/`}>1</a>
      {Array.from({ length: pages - 1 }, (_, index) => {
        const n = index + 2;
        return n === current ? <span aria-current="page">{n}</span> : <a href={`/category/${category}/${n}/`}>{n}</a>;
      })}
    </nav>
  </main>
</Base>

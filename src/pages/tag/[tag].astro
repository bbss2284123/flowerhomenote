---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { allPublished, cardExcerpt, postPath } from "../../lib/posts";
import { formatDot } from "../../lib/dates";

export async function getStaticPaths() {
  const posts = await allPublished();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`} description={`${tag} 태그의 발행 글`} path={`/tag/${tag}/`}>
  <main id="content" class="wrap page" data-pagefind-body>
    <header class="page-head">
      <h1>#{tag}</h1>
    </header>
    <div class="cards">
      {posts.map((post) => (
        <Card
          href={postPath(post.id)}
          title={post.data.title}
          excerpt={cardExcerpt(post.data.description)}
          category={post.data.category}
          image={`/thumb/posts/${post.id}/card.png`}
          overlayTitle={post.data.thumbTitle || post.data.title}
          overlaySub={post.data.thumbSubtitle || post.data.main_query}
          date={formatDot(post.data.date)}
        />
      ))}
    </div>
  </main>
</Base>

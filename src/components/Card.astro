---
import { categoryById } from "../../site.config";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  category: string;
  image: string;
  alt?: string;
  overlayTitle: string;
  overlaySub: string;
  date?: string;
  categoryLabel?: string;
  eager?: boolean;
}
const { href, title, excerpt, category, image, alt = "", overlayTitle, categoryLabel, eager = false } = Astro.props;
const meta = categoryById(category);
const label = categoryLabel || meta?.name || category;
---
<a class="card" href={href} data-category={category}>
  <span class="card-media">
    <img src={image} alt={alt} width="1200" height="675" loading={eager ? "eager" : "lazy"} decoding="async" />
    <span class="card-overlay">
      <h3>{overlayTitle || title}</h3>
    </span>
  </span>
  <span class="card-body">
    <span class="card-kicker" style={`color:${meta?.accent ?? "#416743"}`}>
      <img src={`/icons/${category}.svg`} alt="" width="16" height="16" />
      {label}
    </span>
    <span class="card-excerpt">{excerpt}</span>
  </span>
</a>

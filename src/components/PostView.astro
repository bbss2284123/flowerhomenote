---
import type { CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Card from "./Card.astro";
import Shot from "./mdx/Shot.astro";
import Marker from "./mdx/Marker.astro";
import Arrow from "./mdx/Arrow.astro";
import HighlightBox from "./mdx/HighlightBox.astro";
import Callout from "./mdx/Callout.astro";
import AdSlot from "./mdx/AdSlot.astro";
import Term from "./mdx/Term.astro";
import { categoryById, siteConfig, absoluteUrl } from "../../site.config";
import { templateNames } from "../lib/post-schema";
import { authorName, cardExcerpt, postPath } from "../lib/posts";
import { formatDot, formatKo } from "../lib/dates";
import { headingSlug } from "../lib/slug";

interface Props {
  post: CollectionEntry<"posts">;
  Content: any;
  related: CollectionEntry<"posts">[];
  prev?: CollectionEntry<"posts">;
  next?: CollectionEntry<"posts">;
}
const { post, Content, related, prev, next } = Astro.props;
const category = categoryById(post.data.category);
const toc = [...(post.body ?? "").matchAll(/^##\s+(.+)$/gm)].map((match) => match[1].trim());
const url = absoluteUrl(post.data.draft ? `/draft/${post.id}/` : postPath(post.id));
const author = authorName(post) === siteConfig.name
  ? { "@type": "Organization", name: siteConfig.name, url: siteConfig.url }
  : { "@type": "Person", name: authorName(post) };
const quickLabel = post.data.template === "B"
  ? "한눈에 보는 준비와 주의"
  : post.data.template === "C"
    ? "한눈에 보는 요약"
    : post.data.template === "D"
      ? "이번 달 핵심 체크"
      : "한눈에 보는 핵심 요약";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date,
    dateModified: post.data.updated,
    author,
    publisher: { "@type": "Organization", name: siteConfig.name, url: siteConfig.url, logo: absoluteUrl("/android-chrome-512x512.png") },
    mainEntityOfPage: url,
    image: absoluteUrl(`/thumb/posts/${post.id}/og.png`),
    inLanguage: "ko",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "홈", item: siteConfig.url },
      { "@type": "ListItem", position: 2, name: category?.name, item: absoluteUrl(`/category/${post.data.category}/`) },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
];
const hero = post.data.images.find((image) => image.path === post.data.heroImage) ?? post.data.images[0];
const riskLabel = { low: "낮음", medium: "보통", high: "높음" }[post.data.risk_level];
const reviewLabel = { draft: "초안", "needs-review": "검수 필요", approved: "승인", published: "발행" }[post.data.review_status];
---
<Base
  title={post.data.title}
  description={post.data.description}
  path={post.data.draft ? `/draft/${post.id}/` : postPath(post.id)}
  ogImage={`/thumb/posts/${post.id}/og.png`}
  type="article"
  published={post.data.date}
  modified={post.data.updated}
  current={post.data.category}
  noindex={post.data.draft || post.data.review_status === "draft" || post.data.review_status === "needs-review"}
  jsonLd={jsonLd}
>
  <article id="content" class="wrap article" data-pagefind-body style={`--accent:${category?.accent ?? siteConfig.design.brand}`}>
    <nav class="crumbs" aria-label="경로">
      <a href="/">홈</a>
      <span aria-hidden="true">/</span>
      <a href={`/category/${post.data.category}/`}>{category?.name}</a>
    </nav>
    <div class="kicker-row">
      <a class="cat-pill" href={`/category/${post.data.category}/`}>{category?.name}</a>
      <span class="cat-pill">{templateNames[post.data.template]}</span>
      {post.data.draft && <span class="draft-flag">초안 · 발행되지 않음 · 검증된 관리법이 아닙니다</span>}
    </div>
    <h1>{post.data.title}</h1>
    <p class="meta-line">
      {formatKo(post.data.date)}
      · 수정 {formatDot(post.data.updated)}
      · {authorName(post)}
      · 위험도 {riskLabel}
      · {reviewLabel}
    </p>
    <figure class="hero-figure">
      <span class="card-media">
        <img src={post.data.heroImage} alt={hero?.alt ?? ""} width="1200" height="675" />
        <span class="card-overlay" aria-hidden="true">
          <strong>{post.data.thumbTitle || post.data.title}</strong>
          {post.data.thumbSubtitle && <em>{post.data.thumbSubtitle}</em>}
        </span>
      </span>
      {hero?.caption && <figcaption>{hero.caption}</figcaption>}
    </figure>
    <section class="answer-box">
      <strong>{quickLabel}</strong>
      <p>{post.data.quickAnswer}</p>
    </section>
    {post.data.species_scientific_name && <p class="meta-line">학명 {post.data.species_scientific_name}</p>}
    {post.data.template === "B" && (
      <aside class="callout callout-danger">
        <strong>섞지 않습니다</strong>
        <p>표백제(락스)는 식초, 암모니아, 다른 세정제와 섞지 않습니다. 제품 라벨과 환기를 먼저 봅니다.</p>
      </aside>
    )}
    {post.data.template === "C" && (
      <aside class="callout callout-warn">
        <strong>병원 문의</strong>
        <p>밥을 거부하거나 숨쉬기가 달라 보이면 이 글 대신 동물병원에 문의합니다. 약은 적지 않습니다.</p>
      </aside>
    )}
    {post.data.risk_level === "high" && (
      <aside class="callout callout-danger">
        <strong>확인이 필요한 글</strong>
        <p>확인한 사람: {post.data.verified_by}. 확인일: {post.data.verified_at ?? "없음"}.</p>
      </aside>
    )}
    {toc.length > 0 && (
      <nav class="toc" aria-label="차례">
        <strong>차례</strong>
        <ol>
          {toc.map((item) => <li><a href={`#${headingSlug(item)}`}>{item}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose">
      <Content components={{ Shot, Marker, Arrow, HighlightBox, Callout, AdSlot, Term }} />
    </div>
    <section class="sources">
      <h2>출처와 확인일</h2>
      <ul>
        {post.data.sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer">{source.title}</a>
            <span> · 확인 {source.checked_at}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="image-log">
      <h2>이미지 기록</h2>
      <ul>
        {post.data.images.map((image) => (
          <li>
            {image.alt} · {image.source_type}
            {image.license_proof ? ` · ${image.license_proof}` : ""}
          </li>
        ))}
      </ul>
    </section>
    <section class="related">
      <h2>관련 글</h2>
      {related.length === 0 ? <p>같은 주제의 발행 글이 아직 없습니다.</p> : (
        <div class="cards">
          {related.map((item) => (
            <Card
              href={postPath(item.id)}
              title={item.data.title}
              excerpt={cardExcerpt(item.data.description)}
              category={item.data.category}
              image={`/thumb/posts/${item.id}/card.png`}
              overlayTitle={item.data.thumbTitle || item.data.title}
              overlaySub={item.data.thumbSubtitle || item.data.main_query}
              date={formatDot(item.data.date)}
            />
          ))}
        </div>
      )}
    </section>
    {(prev || next) && (
      <nav class="prevnext" aria-label="이전 다음 글">
        {prev ? <a href={postPath(prev.id)}><span>이전 글</span>{prev.data.title}</a> : <span></span>}
        {next ? <a href={postPath(next.id)}><span>다음 글</span>{next.data.title}</a> : <span></span>}
      </nav>
    )}
  </article>
  <dialog id="lightbox" class="lightbox">
    <div class="lightbox-bar">
      <button type="button" data-zoom="in">크게</button>
      <button type="button" data-zoom="out">작게</button>
      <button type="button" data-zoom="close">닫기</button>
    </div>
    <div class="lightbox-scroll"><img alt="" /></div>
  </dialog>
  <script is:inline>
    const dialog = document.querySelector("#lightbox");
    const img = dialog?.querySelector("img");
    let scale = 1;
    function paint() {
      if (!img) return;
      img.style.width = scale <= 1 ? "min(1200px, 100%)" : `${Math.round(scale * 100)}%`;
      img.style.maxWidth = scale <= 1 ? "100%" : "none";
    }
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !(dialog instanceof HTMLDialogElement) || !img) return;
      const open = target.closest(".shot-open");
      if (open instanceof HTMLElement) {
        img.src = open.dataset.full || "";
        img.alt = open.dataset.alt || "";
        scale = 1;
        paint();
        dialog.showModal();
      }
      if (target.closest("[data-zoom='in']")) { scale = Math.min(2.4, scale + 0.4); paint(); }
      if (target.closest("[data-zoom='out']")) { scale = Math.max(1, scale - 0.4); paint(); }
      if (target.closest("[data-zoom='close']")) dialog.close();
    });
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });
  </script>
</Base>

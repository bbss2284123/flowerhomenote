---
import "../styles/global.css";
import { siteConfig, absoluteUrl } from "../../site.config";
import Seo from "../components/Seo.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: "website" | "article";
  jsonLd?: unknown[];
  published?: string;
  modified?: string;
  current?: string;
  noindex?: boolean;
}
const { title, description, path, ogImage, type = "website", jsonLd = [], published, modified, current = "", noindex = false } = Astro.props;
const canonical = absoluteUrl(path);
---
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={siteConfig.design.brand} />
    <link rel="preload" href="/fonts/pretendard/Pretendard-Regular.subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pretendard/Pretendard-ExtraBold.subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
    <Seo title={title} description={description} canonical={canonical} ogImage={ogImage} type={type} published={published} modified={modified} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body>
    <a class="skip" href="#content">본문으로</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <img src="/brand/logo-horizontal-green.png" alt="꽃과살림노트" width="1050" height="166" />
        </a>
        <nav id="site-menu" class="nav-links" aria-label="주요">
          <form class="nav-search side-search" action="/search/" method="get">
            <input type="search" name="q" placeholder="궁금한 내용을 검색해 보세요" aria-label="메뉴 안 검색" />
            <button type="submit" aria-label="검색">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </form>
          {siteConfig.nav.map((item) => (
            <a class:list={{ "is-on": item.match.includes(current) }} href={item.href} aria-current={item.match.includes(current) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">메뉴</button>
          <button class="icon-btn desktop-search" type="button" data-open-search aria-label="검색">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">{siteConfig.tagline}</p>
        <nav class="footer-cats" aria-label="분류">
          {siteConfig.categories.map((category) => (
            <a href={`/category/${category.id}/`}>{category.name}</a>
          ))}
          {siteConfig.hubs.map((hub) => (
            <a href={`/hub/${hub.id}/`}>{hub.name}</a>
          ))}
        </nav>
        <nav class="footer-links" aria-label="안내">
          <a href="/about/">소개</a>
          <a href="/sources/">출처 기준</a>
          <a href="/contact/">문의</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="legal">© {new Date().getFullYear()} 꽃과살림노트 · flowerhomenote.com</p>
      </div>
    </footer>
    <dialog id="search-dialog" class="search-dialog">
      <form action="/search/" method="get">
        <h2>검색</h2>
        <div class="search-bar">
          <input type="search" name="q" placeholder="궁금한 내용을 검색해 보세요" aria-label="검색어" />
          <button type="submit" aria-label="검색">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="#fff" stroke-width="2"/><path d="M16 16l5 5" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </form>
    </dialog>
    <dialog id="bookmark-dialog" class="modal">
      <h2>즐겨찾기에 추가하는 방법</h2>
      <p>이 사이트가 즐겨찾기를 대신 저장하지는 않습니다. 브라우저에서 직접 추가해 주세요.</p>
      <ol>
        <li>Windows의 Chrome, Edge, Firefox: Ctrl + D</li>
        <li>Mac의 Chrome, Edge, Firefox, Safari: Command + D</li>
        <li>iPhone Safari: 공유 버튼 후 즐겨찾기에 추가</li>
        <li>Android Chrome: 메뉴의 별표 또는 즐겨찾기</li>
        <li>삼성 인터넷: 아래쪽 별표</li>
      </ol>
      <button class="text-btn" type="button" data-close-bookmark>닫기</button>
    </dialog>
    <script is:inline>
      const menuButton = document.querySelector(".menu-toggle");
      const menu = document.querySelector("#site-menu");
      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!open));
        menu?.classList.toggle("is-open", !open);
      });
      const searchDialog = document.querySelector("#search-dialog");
      document.querySelector("[data-open-search]")?.addEventListener("click", () => {
        if (!(searchDialog instanceof HTMLDialogElement)) return;
        searchDialog.showModal();
        searchDialog.querySelector("input")?.focus();
      });
      const bookmarkDialog = document.querySelector("#bookmark-dialog");
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("[data-open-bookmark]") && bookmarkDialog instanceof HTMLDialogElement) bookmarkDialog.showModal();
        if (target.closest("[data-close-bookmark]") && bookmarkDialog instanceof HTMLDialogElement) bookmarkDialog.close();
      });
      for (const dialog of [searchDialog, bookmarkDialog]) {
        dialog?.addEventListener("click", (event) => {
          if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
        });
      }
    </script>
  </body>
</html>
